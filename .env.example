# Linkgo environment settings (example — copy values into your shell, never commit secrets).
#
# Linkgo does not load a .env file automatically. Set these as process
# environment variables before running `bun run tauri:dev` (or before starting
# the installed app). All model/provider credentials are entered in the app and
# stored in the OS keyring, not here.

# Required for LinkedIn sign-in, publishing and commenting.
# Create an app at https://www.linkedin.com/developers/ to get these.
LINKGO_LINKEDIN_CLIENT_ID=
LINKGO_LINKEDIN_CLIENT_SECRET=

# Optional. Must match a redirect URL registered on your LinkedIn app.
# Default: http://localhost:47628/auth/linkedin/callback
# LINKGO_LINKEDIN_REDIRECT_URI=

# Optional. LinkedIn REST API version header (YYYYMM). Default: 202606
# LINKGO_LINKEDIN_VERSION=
